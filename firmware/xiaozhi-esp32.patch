@@ -411,7 +411,29 @@ void EspVideo::SetExplainUrl(const std::string& url, const std::string& token) {
     explain_token_ = token;
 }
 
+bool EspVideo::Peek(const std::function<void(const uint8_t*, int, int, uint32_t)>& fn) {
+    std::lock_guard<std::mutex> lock(mu_);
+    if (!streaming_on_ || video_fd_ < 0) {
+        return false;
+    }
+    // Drop the oldest queued frame, it may be seconds old.
+    for (int i = 0; i < 2; i++) {
+        struct v4l2_buffer buf = {};
+        buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+        buf.memory = V4L2_MEMORY_MMAP;
+        if (ioctl(video_fd_, VIDIOC_DQBUF, &buf) != 0) {
+            return false;
+        }
+        if (i == 1) {
+            fn((const uint8_t*)mmap_buffers_[buf.index].start, frame_.width, frame_.height, sensor_format_);
+        }
+        ioctl(video_fd_, VIDIOC_QBUF, &buf);
+    }
+    return true;
+}
+
 bool EspVideo::Capture() {
+    std::lock_guard<std::mutex> lock(mu_);
     if (encoder_thread_.joinable()) {
         encoder_thread_.join();
     }
