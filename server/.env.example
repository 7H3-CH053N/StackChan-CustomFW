# --- required ---------------------------------------------------------------
# Google AI Studio key (Gemini Live + TTS)
GEMINI_API_KEY=
# Home Assistant long-lived access token (Profile -> Security)
HA_MCP_TOKEN=
# Home Assistant websocket, e.g. wss://homeassistant.example.com/api/websocket
# or ws://192.168.1.10:8123/api/websocket in your LAN
HA_WS_URL=

# --- how the robot reaches this server -----------------------------------------
# LAN only: the server's LAN IP; the robot gets ws://LOCAL_HOST:12800/xiaozhi/ws
LOCAL_HOST=
# Behind a reverse proxy/tunnel with TLS: full websocket URL, overrides LOCAL_HOST
# PUBLIC_WS_URL=wss://stackchan.example.com/xiaozhi/ws

# --- optional -----------------------------------------------------------------
# GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
# GEMINI_VOICE=Aoede
# SYSTEM_PROMPT=You are a small desk robot ...
# TAVILY_API_KEY=        # enables the web_search tool
# N8N_URL=               # enables the n8n_status tool
# N8N_API_KEY=
